<resources>
    <!-- Tema plano, sem fundo translúcido/blur, sem animações de janela custosas:
         windowIsTranslucent/blur custa composição extra de GPU, o que em
         telas 60Hz de baixo custo (Helio G25 + GPU IMG PowerVR fraca) gera
         frame drops visíveis. Preferimos cor sólida e transição instantânea. -->
    <style name="Theme.UmiLauncher.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/background_light</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/background_light</item>
        <item name="android:navigationBarColor">@android:color/background_light</item>
    </style>
</resources>
