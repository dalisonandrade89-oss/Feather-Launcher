<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        FIX (busca não encontrava todos os apps no Android 11+):
        Apps que declaram a categoria HOME (launchers) já recebem, pelo
        próprio sistema, visibilidade automática de qualquer app com um
        Activity MAIN/LAUNCHER — essa é a exceção oficial do Android às
        regras de "package visibility". Ainda assim, alguns fabricantes
        (principalmente MediaTek/OEMs com customizações) aplicam a
        restrição de forma mais agressiva antes de reconhecer o app como
        launcher padrão. Declarar a tag <queries> abaixo remove qualquer
        ambiguidade e garante 100% de visibilidade de apps com LAUNCHER,
        sem exigir justificativa de revisão na Play Store (ao contrário
        de QUERY_ALL_PACKAGES, que é desnecessária aqui e pode gerar
        rejeição/atraso na publicação do app).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Feather"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Feather">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FIX #4 (resumo de notificação na Home): exige que o usuário
            conceda manualmente o "Acesso a notificações" em
            Configurações > Apps > Acesso especial (nenhum app pode
            ganhar essa permissão automaticamente, por design do Android).
        -->
        <service
            android:name=".notification.FeatherNotificationListenerService"
            android:label="Feather Launcher Notificações"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
